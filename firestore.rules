rules_version = '2';
/* Firestore の 守り。Firebase コンソール → Firestore Database → 「ルール」に
   まるごと 貼りつけて「公開」。apiKey は 秘密ではないので、守りは ここで 行う。

   考え方
   ・先生（メール＋パスワードで ログイン）＝ 自分の教室だけ 読み書きできる
   ・生徒（匿名ログイン）＝ 教室の 名前の一覧は 見られるが、
       ほかの子の 記録は 読めない。書けるのは 自分の 記録だけ
   ・生徒は 教室や ほかの生徒を 作ったり 消したり できない          */
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn()  { return request.auth != null; }
    function teacher()   { return signedIn() && request.auth.token.firebase.sign_in_provider == 'password'; }
    function classOwner(cid) {
      return teacher() &&
        get(/databases/$(db)/documents/classes/$(cid)).data.teacherUid == request.auth.uid;
    }
    // その 生徒が「この端末（匿名ログイン）」と むすびついているか
    function isMe(cid, sid) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(db)/documents/classes/$(cid)/students/$(sid)).data.uids;
    }

    /* 先生の 名前。本人だけ */
    match /teachers/{uid} {
      allow read, write: if teacher() && request.auth.uid == uid;
    }

    /* クラスコード → 教室。生徒は コードを 引けるだけ。書きかえは 持ち主の先生だけ */
    match /codes/{code} {
      allow get:    if signedIn();
      allow list:   if false;                                  // 総なめは させない
      allow create: if teacher() && request.resource.data.keys().hasOnly(['classId']);
      allow delete: if teacher() &&
        get(/databases/$(db)/documents/classes/$(resource.data.classId)).data.teacherUid == request.auth.uid;
      allow update: if false;
    }

    /* 教室 */
    match /classes/{cid} {
      allow get:    if signedIn();                              // 参加のとき 名前を 見せる
      allow list:   if teacher() && request.query.limit <= 200; // 一覧は 先生だけ（where で 自分のぶんに しぼる）
      allow create: if teacher() && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if classOwner(cid);

      /* 生徒 */
      match /students/{sid} {
        // 参加のとき「名前の一覧」を 見せる必要がある。にっくねーむ以外の 個人情報は 入れていない
        allow get, list: if signedIn();
        allow create, delete: if classOwner(cid);
        allow update: if classOwner(cid)
          // 生徒本人：自分の 端末を つなぐ／最後に来た日時と まとめを 書く だけ
          || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['uids', 'lastSeen', 'stat'])
              && (isMe(cid, sid)
                  || request.resource.data.uids.hasAll(resource.data.uids)));   // はじめて つなぐとき

        /* 練習の 記録。先生は 読むだけ、本人は 足すだけ（消せない・書きかえられない） */
        match /sessions/{t} {
          allow get, list: if classOwner(cid) || isMe(cid, sid);
          allow create:    if isMe(cid, sid);
          allow update, delete: if false;
        }
      }
    }
  }
}
